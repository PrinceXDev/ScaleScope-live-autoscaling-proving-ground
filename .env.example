# Local development environment variables.
#
# Copy to .env and `source .env` (or use `dotenv`/your shell's env loading)
# before running any service with `npm run start:<name>`. None of this is
# needed on Zerops — there, these same values arrive as Zerops-injected
# cross-service env vars (db_connectionString, cache_connectionString,
# metrics_hostname, ...) which every package in packages/stores already
# checks for first. This file exists only to give the same code something
# equivalent to talk to on your own machine, via docker-compose.yml.

# ---- infrastructure (matches docker-compose.yml) ----------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scalescope
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
CLICKHOUSE_URL=http://localhost:8123

# ---- cross-service secrets and URLs -----------------------------------------
# Any value works locally; on Zerops this is generated once at project import
# and shared between `target` and `chaos` automatically.
CHAOS_SECRET=local-dev-secret

# Where `chaos` sends admin calls, and where `scheduler` starts runs. Point
# these at whichever port you gave each service below.
TARGET_ADMIN_URL=http://localhost:3101
GATEWAY_URL=http://localhost:3100

# ---- per-service ports, so eight processes can run on one machine ----------
# Export the relevant one (or set inline) before starting each service:
#   PORT=3100 npm run start:gateway
GATEWAY_PORT=3100
COLLECTOR_PORT=3102
WORKER_PORT=3103
TARGET_PORT=3101
ORACLE_PORT=3104
CHAOS_PORT=3105
SCHEDULER_PORT=3106

# ---- tuning (optional — sensible defaults are baked in) ---------------------
MAX_RUNS_PER_HOUR=12
SUITE_MAX_RUNS=8
SUITE_MAX_TOTAL_S=900
LOG_LEVEL=info
